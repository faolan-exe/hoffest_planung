# Kopie dieser Datei als ".env" anlegen und ausfuellen.
# Die .env wird von docker compose automatisch gelesen und ist per
# .gitignore vom Repository ausgeschlossen.

# ── Datenbank ────────────────────────────────────────────────────────────
# Beliebiges langes Passwort. Muss beim Umzug NICHT identisch bleiben,
# das Backup enthaelt keine Passwoerter der Datenbankrolle.
POSTGRES_PASSWORD=hier-ein-langes-zufallspasswort

# ── Anwendung ────────────────────────────────────────────────────────────
# Signaturschluessel fuer die Flask-Sessions.
# Neu erzeugen mit:  python3 -c "import secrets;print(secrets.token_hex(32))"
# ACHTUNG: Beim Aendern werden alle angemeldeten Nutzer abgemeldet.
FLASK_SECRET_KEY=

# Gemeinsames Geheimnis mit dem Moodle-Snippet (moodle code/authCodeV2.js).
# MUSS beim Serverumzug identisch bleiben, sonst kommt niemand mehr rein.
AUTH_SECRET=

# Oeffentliche Adresse der Seite (fuer Links in E-Mails).
DOMAIN=https://hoffest.t-auer.com

# ── E-Mail-Versand ───────────────────────────────────────────────────────
SMTP_HOST=smtp.strato.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
